rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function hasUserProfile() {
      return isAuthenticated()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function currentUserRole() {
      return hasUserProfile()
        ? firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isAuthorizedStaff() {
      return currentUserRole() == 'barangay' || currentUserRole() == 'developer';
    }

    match /knowledge-base/audio/{allPaths=**} {
      allow read, write: if isAuthorizedStaff();
    }

    match /farmer-evidence/{allPaths=**} {
      allow read, write: if isAuthorizedStaff();
    }
  }
}
